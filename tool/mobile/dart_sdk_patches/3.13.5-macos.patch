+// dart_ui (appkitEmbedded): as a .app's executable the runtime finds its
+// program in the bundle, at Contents/Frameworks/App.framework/App, and runs
+// the main isolate on the main thread (main_impl.cc). The arguments the app
+// was opened with go to the program, without macOS's old -psn_ one.
+static void MacRunBundle(int argc, char** argv) {
+  char executable[PATH_MAX];
+  uint32_t size = sizeof(executable);
+  if (_NSGetExecutablePath(executable, &size) != 0) return;
+  char resolved[PATH_MAX];
+  if (realpath(executable, resolved) == nullptr) return;
+  char* slash = strrchr(resolved, '/');
+  if (slash == nullptr) return;
+  *slash = '\0';
+  static char snapshot[PATH_MAX];
+  snprintf(snapshot, sizeof(snapshot), "%s/../Frameworks/App.framework/App",
+           resolved);
+  struct stat info;
+  if (stat(snapshot, &info) != 0) return;
+  char** bundle_argv = static_cast<char**>(calloc(argc + 2, sizeof(char*)));
+  int count = 0;
+  bundle_argv[count++] = argv[0];
+  bundle_argv[count++] = snapshot;
+  for (int i = 1; i < argc; i++) {
+    if (strncmp(argv[i], "-psn_", 5) != 0) bundle_argv[count++] = argv[i];
+  }
+  dart::bin::dart_ui_main_thread_loop = true;
+  dart::bin::main(count, bundle_argv);
+}
+#endif
