 int main(int argc, char** argv) {
+#if defined(DART_HOST_OS_IOS)
+  // dart_ui: iOS launches an app with no arguments. The snapshot is the
+  // signed dylib the bundle carries at Frameworks/App.framework/App.
+  if (argc < 2) {
+    const char* slash = strrchr(argv[0], '/');
+    const size_t dir = slash == nullptr ? 0 : slash - argv[0] + 1;
+    static const char kSnapshot[] = "Frameworks/App.framework/App";
+    char* path = static_cast<char*>(malloc(dir + sizeof(kSnapshot)));
+    memcpy(path, argv[0], dir);
+    memcpy(path + dir, kSnapshot, sizeof(kSnapshot));
+    static char* ios_argv[3];
+    ios_argv[0] = argv[0];
+    ios_argv[1] = path;
+    ios_argv[2] = nullptr;
+    dart::bin::main(2, ios_argv);
+  }
+#endif
   dart::bin::main(argc, argv);
   UNREACHABLE();
 }
diff --git a/runtime/bin/main_impl.cc b/runtime/bin/main_impl.cc
index ab1c5411..f1a76707 100644
--- a/runtime/bin/main_impl.cc
+++ b/runtime/bin/main_impl.cc
@@ -966,6 +966,76 @@ static void CompileAndSaveKernel(const char* script_name,
   WriteDepsFile();
 }
 
+#if defined(DART_HOST_OS_IOS)
+// dart_ui: on iOS the main isolate's messages are handled on the main thread,
+// from the main run loop, so the Dart code may call UIKit directly and UIKit
+// may call back into it (NativeCallable.isolateLocal). The isolate stays
+// entered on this thread for the life of the process. Dart's main() returns
+// after registering its classes; this then runs UIApplicationMain with the
+// delegate class the application registered, "DartUiAppDelegate". A program
+// that registers none gets a plain CFRunLoopRun.
+}  // namespace bin
+}  // namespace dart
+#include <CoreFoundation/CoreFoundation.h>
+#include <dlfcn.h>
+#include <atomic>
+namespace dart {
+namespace bin {
+
+static std::atomic<intptr_t> ios_pending_messages{0};
+static CFRunLoopSourceRef ios_message_source = nullptr;
+static CFRunLoopRef ios_main_loop = nullptr;
+
+static void IosNotifyMessage(Dart_Isolate) {
+  ios_pending_messages.fetch_add(1);
+  CFRunLoopSourceSignal(ios_message_source);
+  CFRunLoopWakeUp(ios_main_loop);
+}
+
+static void IosHandleMessages(void*) {
+  for (intptr_t n = ios_pending_messages.exchange(0); n > 0; n--) {
+    Dart_EnterScope();
+    Dart_Handle result = Dart_HandleMessage();
+    if (Dart_IsError(result)) {
+      Syslog::PrintErr("%s\n", Dart_GetError(result));
+    }
+    Dart_ExitScope();
+  }
+}
+
+static void IosInstallMessageLoop() {
+  ios_main_loop = CFRunLoopGetMain();
+  CFRunLoopSourceContext context = {};
+  context.perform = IosHandleMessages;
+  ios_message_source = CFRunLoopSourceCreate(nullptr, 0, &context);
+  CFRunLoopAddSource(ios_main_loop, ios_message_source, kCFRunLoopCommonModes);
+  Dart_SetMessageNotifyCallback(IosNotifyMessage);
+}
+
+[[noreturn]] static void IosRunMainLoop() {
+  // main() and whatever it queued synchronously.
+  IosHandleMessages(nullptr);
+  using GetClass = void* (*)(const char*);
+  using AppMain = int (*)(int, char**, const void*, const void*);
+  auto get_class =
+      reinterpret_cast<GetClass>(dlsym(RTLD_DEFAULT, "objc_getClass"));
+  // The delegate may be registered after main()'s first await, when the
+  // application gets to its backend; the run loop keeps handling Dart's
+  // messages until it is. UIKit is loaded by then, so its symbol resolves.
+  while (get_class == nullptr || get_class("DartUiAppDelegate") == nullptr) {
+    CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.05, true);
+  }
+  auto app_main =
+      reinterpret_cast<AppMain>(dlsym(RTLD_DEFAULT, "UIApplicationMain"));
+  if (app_main != nullptr) {
+    app_main(0, nullptr, nullptr, CFSTR("DartUiAppDelegate"));
+  }
+  while (true) {
+    CFRunLoopRun();
+  }
+}
+#endif  // defined(DART_HOST_OS_IOS)
+
 void RunMainIsolate(const char* script_name,
                     const char* asset_resolution_base,
                     const char* package_config_override,
@@ -1068,10 +1138,17 @@ void RunMainIsolate(const char* script_name,
 
   Dart_Handle isolate_lib =
